.next/
node_modules/
.env.local
.vercel/

.vercel

# next-pwa generated service workers (rebuilt on every `next build`)
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/swe-worker-*.js

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# research pipeline caches/outputs (regenerable)
research/.cache/
research/out/*

# …salvo los ARTEFACTOS DE EVIDENCIA. No son "regenerables" en el sentido que importa:
# son la justificación de constantes que van en el código (ENSEMBLE_WEIGHTS,
# GROWTH_BACKTEST, ALLOCATOR_BACKTEST…) y la entrada de los guardianes anti-deriva del
# golden test. Mientras estuvieron ignorados, esos guardianes se saltaban en SILENCIO en
# cada checkout limpio y los pesos derivaron meses sin que nadie lo viera. Un guardián que
# se salta solo es peor que no tener guardián: da la señal verde sin haber mirado.
# Son ficheros de 1-105 KB. Versionarlos es el precio de que la evidencia sea reproducible.
!research/out/signals_ic.json
!research/out/growth_metrics.json
!research/out/backtest_assets_summary.json
!research/out/regime_factor_validate.json
!research/out/portfolio_backtest.json
!research/out/capture_lab.json
!research/out/allocator_lab.json
!research/out/backtest_summary.json
!research/out/trials_ledger.json
!research/out/factor_lab.json
# Evidencia de Scora Picks: los números de SCORA_PICKS_REGLAS.md §3 y §6 salen de aquí.
# El documento es un PRE-REGISTRO — si la evidencia que lo respalda no está versionada,
# nadie puede comprobar mañana que los números publicados son los que se midieron.
!research/out/quality_lowvol_lab.json
!research/out/quality_lowvol_lab_oos.json
# Evidencia de decisiones que ya viven en el código o en un plan:
!research/out/score_v2_validate.json
!research/out/momentum_lab.json
!research/out/momentum_audit.json
!research/out/momentum_audit_long.json
# Evidencia del backtest de las REGLAS (§6bis) y de la refutación de la dilución.
# Los paneles de señal (`picks_signal_panel_*`) NO: son 0,6-0,9 MB regenerables y no
# sostienen ninguna afirmación por sí solos.
!research/out/picks_rules_backtest.json
!research/out/picks_rules_backtest_oos.json
!research/out/pillar_dilution_lab.json
!research/out/pillar_dilution_lab_oos.json
!research/out/health_scale_lab.json
!research/out/health_scale_lab_oos.json
