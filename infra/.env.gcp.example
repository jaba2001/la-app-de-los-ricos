# Credenciales para el despliegue en Google Cloud.
#
#   cp infra/.env.gcp.example infra/.env.gcp
#
# infra/.env.gcp esta en .gitignore y NO debe subirse nunca. Lo leen dos scripts:
# set-secrets.sh (sube los secretos del backend a Secret Manager) y build-and-push.sh
# (incrusta las NEXT_PUBLIC_* en la imagen).
#
# Lo que se deje en blanco se sube como cadena vacia y desactiva su funcion sin romper el
# arranque. Empieza por las marcadas IMPRESCINDIBLE.
#
# Revisado el 27-09-2026 contra las 62 variables que lee el codigo (AUDIT_REPORT M-7). La
# configuracion NO secreta no va aqui: esta al final, con donde se fija cada una.

# ══ Backend — secretos (van a Secret Manager) ════════════════════════════════════════

# ── Datos de mercado ──
FMP_KEY=                      # IMPRESCINDIBLE. financialmodelingprep.com — 20 de las 33 llamadas de un ticker
FINNHUB_KEY=                  # IMPRESCINDIBLE. finnhub.io — rellena lo que FMP no cubre
FRED_KEY=                     # IMPRESCINDIBLE. fred.stlouisfed.org — todo el motor macro. Gratuita
SIMFIN_KEY=                   # Opcional: financieros de empresas europeas

# ── Base de datos (Cloud SQL) ──
PGPASSWORD=                   # IMPRESCINDIBLE. La del usuario de la app en Cloud SQL

# ── Modelos de lenguaje ── sin ninguno, las 8 superficies de IA responden error
ANTHROPIC_KEY=                # El proveedor por defecto de la capa de IA
GROQ_KEY=                     # Alternativa gratuita (LLM_PROVIDER=groq)
GEMINI_KEY=                   # Respaldo de la anterior (LLM_FALLBACK=gemini)

# ── Redis (Upstash) ── sin esto no hay cache, ni limite de ritmo, ni CUOTA DIARIA DE IA:
#    las tres dejan pasar todo. La app funciona, sin tope de gasto (AUDIT_REPORT A-2).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_CACHE_REST_URL=       # Opcional: instancia SEPARADA para la cache
UPSTASH_CACHE_REST_TOKEN=     # Recomendado — comparten instancia en `noeviction` y una cache
                              # llena deja sin funcionar al limitador, que es el tope de gasto

# ── Cobros ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Notificaciones ──
RESEND_KEY=                   # Correo
VAPID_PRIVATE_KEY=            # Push web. Generar con: npx web-push generate-vapid-keys
ELEVENLABS_KEY=               # Voz del brief macro

# ── Crons ── IMPRESCINDIBLE
CRON_SECRET=                  # Invéntalo largo y aleatorio: openssl rand -hex 32
                              # El MISMO valor va en infra/terraform/terraform.tfvars

# ── Supabase ── YA NO son imprescindibles: la app no usa Supabase ni para la sesion ni
#    para los datos. Solo queda UN uso: lib/server/tts.js sube el audio del brief a Supabase
#    Storage con SUPABASE_URL + SUPABASE_SERVICE_KEY (pendiente de migrar, AUDIT_REPORT D-1).
#    Las otras dos no las lee el codigo; siguen aqui porque Terraform aun crea su secreto.
SUPABASE_SERVICE_KEY=         # Solo para el audio del brief (ver arriba)
SUPABASE_ANON_KEY=            # Sin uso. Dejar en blanco
SUPABASE_JWT_SECRET=          # Sin uso. Dejar en blanco

# ══ Frontend — se INCRUSTAN al construir la imagen ═══════════════════════════════════
# Cambiar cualquiera de estas obliga a reconstruir; redesplegar no basta.

# ── Identity Platform ── IMPRESCINDIBLES: build-and-push.sh se niega a construir sin ellas,
#    porque sin ellas NADIE puede iniciar sesion. Consola de Firebase → Configuracion del
#    proyecto → Tus apps → SDK config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=     # <proyecto>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=      # El id del proyecto; tiene que coincidir con GCP_PROJECT_ID

NEXT_PUBLIC_SITE_URL=         # La direccion publica: URL canonica, sitemap y vuelta de Stripe.
                              # Vacio = la de Cloud Run. Ponla cuando haya dominio propio.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_VAPID_PUBLIC_KEY= # La publica del par VAPID
NEXT_PUBLIC_AI_PROVIDER=      # Vacio = Anthropic. "free" = ruta /api/llm (Groq/Gemini)
NEXT_PUBLIC_BATCH_DISABLED=   # "1" apaga la agrupacion de peticiones. Interruptor de emergencia

# NEXT_PUBLIC_PROXY_URL ya no hace falta: las rutas /api/* viven en esta misma app, asi que
# el navegador llama a su propio origen. Solo se pone si algun dia se apunta a otro backend.
#
# NEXT_PUBLIC_SUPABASE_URL y NEXT_PUBLIC_SUPABASE_ANON_KEY ya no existen. /daily y /picks
# eran lo ultimo que las leia, y leen de Cloud SQL desde el 27-09 (AUDIT_REPORT C-2).

# ══ Solo para construir (opcional) ═══════════════════════════════════════════════════
SENTRY_AUTH_TOKEN=            # Sin el, el build va igual y no sube sourcemaps
SENTRY_ORG=
SENTRY_PROJECT=

# ══ Configuracion NO secreta — NO va en este fichero ═════════════════════════════════
# Referencia de lo que lee el codigo y donde se fija. Las de Terraform estan en
# infra/terraform/cloudrun.tf (`local.config` o variables); las demas tienen un valor por
# defecto en el codigo y solo hace falta ponerlas para cambiarlo.
#
#   GCP_PROJECT_ID         Terraform (var.project_id). IMPRESCINDIBLE: sin ella toda ruta
#                          con sesion da 503 (lib/server/auth.js). GOOGLE_CLOUD_PROJECT vale
#                          como alternativa.
#   CLOUD_SQL_INSTANCE     Terraform. proyecto:region:instancia → socket /cloudsql/…
#   PGDATABASE, PGUSER     Terraform ("scora", "postgres")
#   PGHOST, PGPORT         Solo en local, sin CLOUD_SQL_INSTANCE (127.0.0.1:5432)
#   PGPOOL_MAX             Conexiones por instancia (5)
#   APP_URL                Terraform. Origen para las URLs de vuelta de Stripe
#   ALLOWED_ORIGINS        Terraform. Origenes CORS permitidos, separados por comas
#   SUPABASE_URL           Terraform. Solo para el audio del brief (ver Supabase, arriba)
#   VAPID_PUBLIC_KEY       Terraform. La misma que NEXT_PUBLIC_VAPID_PUBLIC_KEY
#   VAPID_SUBJECT          Terraform. mailto: de contacto para el push
#   NODE_ENV               Terraform ("production")
#   AI_DAILY_FREE          Terraform. Cuota diaria de IA, plan gratuito (5)
#   AI_DAILY_PRO           Terraform. Cuota diaria de IA, Pro (100)
#   LLM_PROVIDER           Terraform. Proveedor de /api/llm ("groq")
#   LLM_FALLBACK           Terraform. Su respaldo ("gemini")
#   GROQ_MODEL, GEMINI_MODEL   Modelo de cada uno (valor por defecto en app/api/llm)
#   RATELIMIT_FAIL_CLOSED  Terraform. "1" = 503 si Redis no responde; "0" = deja pasar
#   CACHE_DISABLED         "1" apaga la cache de proveedores (lib/server/cache.js)
#   STRIPE_PRICE_ID        El precio de Pro en Stripe. Sin el, /pricing no ofrece pago
#   RESEND_FROM            Remitente del correo (lib/server/email.js)
#   BRIEF_CADENCE          Cadencia del brief macro (app/api/cron/macro-brief)
#   ELEVENLABS_MODEL, ELEVENLABS_VOICE_ID   Voz del brief (lib/server/tts.js)
#   NEXT_RUNTIME           La pone Next; no se toca
